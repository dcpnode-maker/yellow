# Database identities are injected separately. Local setup writes generated passwords
# only to the ignored .yellow/runtime-database-authority.env authority file.
YELLOW_DEPLOY_DATABASE_URL=
YELLOW_RUNTIME_DATABASE_URL=
YELLOW_EXTENSION_REGISTRAR_DATABASE_URL=
YELLOW_DEPLOY_DATABASE_PASSWORD=
YELLOW_RUNTIME_DATABASE_PASSWORD=
YELLOW_EXTENSION_REGISTRAR_DATABASE_PASSWORD=
VALKEY_URL=redis://127.0.0.1:6389
YELLOW_TOKEN_SECRET=
GITHUB_TOKEN=
# Fiscal/statutory credentials are injected at deploy, never stored here.
